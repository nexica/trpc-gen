{
    "name": "@nexica/trpc-gen",
    "version": "1.0.0-dev.9",
    "description": "Custom Prisma generator for NestJS TRPC routers",
    "main": "dist/index.js",
    "bin": {
        "nexica-trpc-gen": "dist/index.js"
    },
    "files": [
        "dist/",
        "README.md",
        "CHANGELOG.md"
    ],
    "types": "dist/index.d.ts",
    "keywords": [
        "prisma",
        "generator",
        "nestjs",
        "trpc",
        "router"
    ],
    "author": "Jamie Fairweather",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/nexica/trpc-gen"
    },
    "scripts": {
        "prepare": "husky",
        "lint": "eslint . **/*.ts --fix",
        "format": "prettier --write **/*.{js,ts,json,yml,yaml}",
        "build": "rimraf dist && pnpm lint && pnpm format && tsc --outDir dist"
    },
    "dependencies": {
        "@prisma/generator-helper": "^6.9.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@eslint/js": "^9.28.0",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/git": "^10.0.1",
        "@semantic-release/npm": "^12.0.1",
        "@semantic-release/release-notes-generator": "^14.0.3",
        "@types/node": "^22.15.31",
        "eslint": "^9.28.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-prettier": "^5.4.1",
        "globals": "^16.2.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.1.0",
        "prettier": "^3.5.3",
        "rimraf": "^6.0.1",
        "semantic-release": "^24.2.5",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.34.0"
    },
    "lint-staged": {
        "**/*.ts": [
            "prettier --write",
            "eslint --fix"
        ]
    },
    "release": {
        "branches": [
            {
                "name": "dev",
                "channel": "dev",
                "prerelease": true
            },
            {
                "name": "rc",
                "channel": "next",
                "prerelease": "rc"
            },
            "main"
        ],
        "plugins": [
            "@semantic-release/commit-analyzer",
            "@semantic-release/release-notes-generator",
            "@semantic-release/changelog",
            "@semantic-release/npm",
            "@semantic-release/git"
        ]
    }
}
