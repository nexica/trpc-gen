{
    "name": "@nexica/trpc-gen",
    "version": "0.0.1",
    "description": "Custom Prisma generator for NestJS TRPC routers",
    "main": "dist/index.js",
    "bin": {
        "@nexica/trpc-gen": "dist/index.js"
    },
    "types": "dist/index.d.ts",
    "keywords": [
        "prisma",
        "generator",
        "nestjs",
        "trpc",
        "router"
    ],
    "author": "Jamie Fairweather",
    "license": "MIT",
    "scripts": {
        "prepare": "husky",
        "lint": "eslint . **/*.ts --fix",
        "format": "prettier --write .",
        "build": "rimraf dist && pnpm lint && pnpm format && tsc",
        "pre-commit": "pnpm lint && pnpm format"
    },
    "dependencies": {
        "@prisma/generator-helper": "^6.7.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.8.0",
        "@commitlint/config-conventional": "^19.8.0",
        "@eslint/js": "^9.25.1",
        "@types/node": "^22.15.3",
        "eslint-config-prettier": "^10.1.2",
        "eslint-plugin-prettier": "^5.2.6",
        "globals": "^16.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.0.0",
        "rimraf": "^6.0.1",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.31.1"
    },
    "lint-staged": {
        "**/*.ts": [
            "prettier --write",
            "eslint --fix"
        ]
    }
}
